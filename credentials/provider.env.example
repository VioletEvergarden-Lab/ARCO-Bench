# Model generation only; scoring your own saved answers requires no credentials.
# Copy outside the package, fill the needed variable, and pass --env-file PATH.
# The unified runner also accepts process environment variables.
# Keep real values outside the repository and anonymous replication package.
DEEPSEEK_API_KEY=REPLACE_LOCALLY
OPENAI_API_KEY=REPLACE_LOCALLY
MODEL_API_KEY=REPLACE_LOCALLY
